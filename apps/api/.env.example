MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=atlas
PORT=3001

REDIS_URL=redis://127.0.0.1:6379

INTELLIGENCE_URL=http://127.0.0.1:8000

CORS_ORIGINS=

# OAuth login (per-provider; a provider is enabled only when both its id and secret are set).
# WEB_APP_URL is the app origin the callback round-trips through and redirects back to after login.
WEB_APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed script: creates a password-login admin user (`bun run seed:admin`).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

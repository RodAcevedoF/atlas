FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 PYTHONUNBUFFERED=1
COPY services/intelligence/pyproject.toml services/intelligence/uv.lock ./
RUN uv sync --frozen --no-dev
COPY services/intelligence/app ./app
RUN useradd --uid 10001 --create-home atlas
USER atlas
CMD ["/app/.venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8888"]

# API SETTINGS
INTELLIGENCE_HOST=127.0.0.1
INTELLIGENCE_PORT=8888
INTELLIGENCE_RELOAD=true

# LLM PROVIDER (openai | cerebras)
INTELLIGENCE_LLM_PROVIDER=openai
INTELLIGENCE_LLM_MODEL=gpt-4o-mini
INTELLIGENCE_OPENAI_API_KEY=
INTELLIGENCE_CEREBRAS_API_KEY=

# EXA
EXA_API_KEY=
INTELLIGENCE_EXA_SEARCH_TYPE=auto
INTELLIGENCE_EXA_RESULTS=25
# UNIT PRICES
INTELLIGENCE_EXA_PRICE_SEARCH_PER_1K=7.0
INTELLIGENCE_EXA_PRICE_EXTRA_RESULT_PER_1K=1.0
INTELLIGENCE_EXA_PRICE_CONTENT_PAGE_PER_1K=1.0
INTELLIGENCE_EXA_SEARCH_INCLUDED_RESULTS=10

# TRACING
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlas-intelligence
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
